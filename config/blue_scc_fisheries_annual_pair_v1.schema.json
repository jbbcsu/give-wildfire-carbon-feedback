{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://give.local/contracts/blue-scc-fisheries-annual-pair-v1.schema.json",
  "title": "Blue-SCC fisheries matched annual country-path admission contract",
  "description": "Admission-only contract. Passing does not calculate or authorize a damage function or SCC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_id",
    "authorization",
    "source",
    "license",
    "files",
    "pulse",
    "coverage",
    "units",
    "welfare_boundary",
    "reconciliation"
  ],
  "properties": {
    "contract_version": {"const": "blue_scc_fisheries_annual_pair_v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "import", "damage_function", "discounting", "scc"],
      "properties": {
        "purpose": {"const": "artifact_admission_only"},
        "import": {"const": true},
        "damage_function": {"const": false},
        "discounting": {"const": false},
        "scc": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "repository_commit", "paper_doi", "derivation_id"],
      "properties": {
        "repository_url": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "paper_doi": {"type": "string", "minLength": 1},
        "derivation_id": {"type": "string", "minLength": 1}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_id",
        "rights_holder",
        "redistribution_allowed",
        "derivative_use_allowed",
        "give_research_use_allowed",
        "attribution_text",
        "third_party_restrictions"
      ],
      "properties": {
        "license_id": {"type": "string", "minLength": 1},
        "rights_holder": {"type": "string", "minLength": 1},
        "redistribution_allowed": {"const": true},
        "derivative_use_allowed": {"const": true},
        "give_research_use_allowed": {"const": true},
        "attribution_text": {"type": "string", "minLength": 1},
        "third_party_restrictions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_path", "pulse_path", "country_mapping", "global_reconciliation"],
      "properties": {
        "baseline_path": {"$ref": "#/$defs/csv_file"},
        "pulse_path": {"$ref": "#/$defs/csv_file"},
        "country_mapping": {"$ref": "#/$defs/csv_file"},
        "global_reconciliation": {"$ref": "#/$defs/csv_file"}
      }
    },
    "pulse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pulse_id",
        "gas",
        "mass",
        "mass_unit",
        "pulse_year",
        "baseline_run_id",
        "pulse_run_id",
        "run_configuration_id",
        "climate_module",
        "socioeconomic_scenario",
        "discounting_applied"
      ],
      "properties": {
        "pulse_id": {"type": "string", "minLength": 1},
        "gas": {"const": "CO2"},
        "mass": {"type": "number", "exclusiveMinimum": 0},
        "mass_unit": {"const": "tCO2"},
        "pulse_year": {"type": "integer", "minimum": 1900, "maximum": 2300},
        "baseline_run_id": {"type": "string", "minLength": 1},
        "pulse_run_id": {"type": "string", "minLength": 1},
        "run_configuration_id": {"type": "string", "minLength": 1},
        "climate_module": {"type": "string", "minLength": 1},
        "socioeconomic_scenario": {"type": "string", "minLength": 1},
        "discounting_applied": {"const": false}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_count", "start_year", "end_year", "draw_ids", "complete", "missingness_rule"],
      "properties": {
        "country_count": {"type": "integer", "minimum": 1},
        "start_year": {"type": "integer", "minimum": 1900, "maximum": 2300},
        "end_year": {"type": "integer", "minimum": 1900, "maximum": 2300},
        "draw_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "complete": {"const": true},
        "missingness_rule": {"const": "explicit_no_zero_fill_imputation_or_renormalization"}
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "price_year", "time_basis", "value_basis"],
      "properties": {
        "currency": {"const": "USD"},
        "price_year": {"type": "integer", "minimum": 1900, "maximum": 2300},
        "time_basis": {"const": "annual_flow"},
        "value_basis": {"const": "undiscounted_direct_welfare_level"}
      }
    },
    "welfare_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_measure",
        "consumer_component",
        "producer_component",
        "nutrition_mortality_treatment",
        "includes_nutrition_or_mortality",
        "includes_indirect_or_induced_output",
        "uses_accounting_profit_as_producer_surplus",
        "uses_gross_revenue_as_welfare",
        "includes_aquaculture",
        "includes_coral_or_reef_services",
        "includes_biodiversity_nonuse_value",
        "includes_ciam_coastal_impacts",
        "overlap_review_status",
        "accounting_boundary_id"
      ],
      "properties": {
        "market_measure": {"const": "direct_consumer_plus_producer_surplus"},
        "consumer_component": {"const": "consumer_surplus"},
        "producer_component": {"const": "producer_surplus"},
        "nutrition_mortality_treatment": {"const": "excluded_and_not_present_in_market_paths"},
        "includes_nutrition_or_mortality": {"const": false},
        "includes_indirect_or_induced_output": {"const": false},
        "uses_accounting_profit_as_producer_surplus": {"const": false},
        "uses_gross_revenue_as_welfare": {"const": false},
        "includes_aquaculture": {"const": false},
        "includes_coral_or_reef_services": {"const": false},
        "includes_biodiversity_nonuse_value": {"const": false},
        "includes_ciam_coastal_impacts": {"const": false},
        "overlap_review_status": {"const": "passed"},
        "accounting_boundary_id": {"type": "string", "minLength": 1}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_tolerance", "relative_tolerance", "country_paths_add_to_global", "market_total_equals_consumer_plus_producer"],
      "properties": {
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "country_paths_add_to_global": {"const": true},
        "market_total_equals_consumer_plus_producer": {"const": true}
      }
    }
  },
  "$defs": {
    "csv_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_size", "format", "media_type"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1},
        "format": {"const": "csv"},
        "media_type": {"const": "text/csv"}
      }
    }
  }
}
